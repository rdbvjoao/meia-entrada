@model MeiaEntrada.Web.ViewModels.Eventos.EventoDetalheViewModel
@{ViewData["Title"]="Excluir evento";}
<h1>Excluir evento?</h1><section class="surface form-surface"><p>Evento #@Model.Evento.Id — <strong>@Model.Evento.Nome</strong></p><p>Eventos com ingressos ou vendas vinculados não podem ser excluídos.</p><form method="post"><button name="Confirmar" value="sim" class="btn btn-danger">Confirmar exclusão</button> <a class="btn btn-outline-secondary" href="/eventos/@Model.Evento.Id/">Voltar</a></form></section>
