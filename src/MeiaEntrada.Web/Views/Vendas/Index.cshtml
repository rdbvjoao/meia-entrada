@model ListaViewModel<Venda>
@{ViewData["Title"]="Histórico de vendas";}
<div class="d-flex flex-wrap justify-content-between gap-3"><div><p class="eyebrow">MOVIMENTAÇÕES</p><h1>Histórico de vendas</h1><p class="subtitle">Cada registro preserva os dados do momento da venda.</p></div><div><a class="btn btn-primary" href="/vendas/nova/">+ Registrar venda</a></div></div>
<section class="surface">
@if(Model.Itens.Count==0){<div class="empty"><h2>Nenhuma venda registrada</h2><p>As vendas aparecerão aqui, das mais recentes às mais antigas.</p><a href="/vendas/nova/">Registrar primeira venda</a></div>}
else{<div class="table-responsive"><table class="table"><thead><tr><th>Venda / evento</th><th>Tipo</th><th>Quantidade</th><th>Total</th><th>Data e horário</th><th>Situação</th><th>Ações</th></tr></thead><tbody>
@foreach(var v in Model.Itens){<tr><td><small class="text-muted">#@v.Id</small><br/><strong>@v.EventoNome</strong></td><td>@v.IngressoTipo.Rotulo()</td><td>@v.Quantidade</td><td class="money">@ValoresMonetarios.Brl(v.ValorTotalCentavos)</td><td>@ValoresMonetarios.Brasilia(v.RegistradaEmUtc)</td><td><span class="badge-state">@(v.Situacao==SituacaoVenda.Registrada?"Registrada":"Cancelada")</span></td><td><a href="/vendas/@v.Id/">Consultar</a>@if(v.Situacao==SituacaoVenda.Registrada){<span> · </span><a href="/vendas/@v.Id/cancelar/">Cancelar</a>}</td></tr>}
</tbody></table></div><partial name="_Paginacao" model="Model.Paginacao" />}
</section>

