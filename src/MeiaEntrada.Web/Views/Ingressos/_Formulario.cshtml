@model MeiaEntrada.Web.ViewModels.Ingressos.IngressoFormViewModel
<div asp-validation-summary="All" role="alert"></div>
@if(Model.Eventos.Count==0){<p>Cadastre um evento antes de criar ingressos. <a href="/eventos/novo/">Novo evento</a></p>}
@if(Model.SaldoAtual.HasValue){<div class="alert alert-warning" role="alert">Saldo atual: <strong>@Model.SaldoAtual</strong>. O valor tentado está no campo abaixo. Revise antes de salvar novamente.</div>}
<input asp-for="Versao" type="hidden" />
<div class="mb-3"><label asp-for="EventoId" class="form-label">Evento</label><select asp-for="EventoId" class="form-select" required><option value="">Selecione um evento</option>@foreach(var e in Model.Eventos){<option value="@e.Id">@e.Nome (#@e.Id)</option>}</select><span asp-validation-for="EventoId"></span></div>
<div class="mb-3"><label asp-for="Tipo" class="form-label">Tipo de ingresso</label><select asp-for="Tipo" class="form-select" required><option value="">Selecione o tipo</option><option value="inteira">Inteira</option><option value="meia_entrada">Meia-entrada</option></select><span asp-validation-for="Tipo"></span></div>
<div class="row"><div class="col-sm-6 mb-4"><label asp-for="Preco" class="form-label">Preço (R$)</label><input asp-for="Preco" class="form-control" inputmode="decimal" required /><span asp-validation-for="Preco"></span></div>
<div class="col-sm-6 mb-4"><label asp-for="QuantidadeDisponivel" class="form-label">Saldo disponível</label><input asp-for="QuantidadeDisponivel" class="form-control" inputmode="numeric" required /><span asp-validation-for="QuantidadeDisponivel"></span><small class="text-muted">Define o saldo atual, não a capacidade total.</small></div></div>
<div class="actions"><button type="submit" class="btn btn-primary" disabled="@(Model.Eventos.Count==0)">Salvar ingresso</button><a class="btn btn-outline-secondary" href="/ingressos/">Voltar</a></div>
