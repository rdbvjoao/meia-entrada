@model ListaViewModel<Ingresso>
@{ViewData["Title"]="Ingressos";}
<div class="d-flex flex-wrap justify-content-between gap-3"><div><p class="eyebrow">OFERTA E DISPONIBILIDADE</p><h1>Ingressos</h1><p class="subtitle">Defina os tipos, os preços e o saldo de cada evento.</p></div><div><a class="btn btn-primary" href="/ingressos/novo/?evento=@Model.Paginacao.Evento">+ Novo ingresso</a></div></div>
<section class="surface"><div class="section-heading"><h2>Catálogo de ingressos</h2><span>Tipos, valores e disponibilidade</span></div>
@if(Model.Itens.Count==0){<div class="empty"><h2>Nenhum ingresso por aqui</h2><p>Cadastre um tipo para começar a vender.</p><a href="/ingressos/novo/">Cadastrar ingresso</a></div>}
else{<div class="table-responsive"><table class="table responsive-table" role="table"><thead><tr><th scope="col">Evento</th><th scope="col">Tipo</th><th scope="col">Preço</th><th scope="col">Disponíveis</th><th scope="col">Ações</th></tr></thead><tbody>@foreach(var i in Model.Itens){<tr><td data-label="Evento">@i.Evento.Nome</td><td data-label="Tipo"><span class="ticket-type">@i.Tipo.Rotulo()</span></td><td data-label="Preço" class="money">@ValoresMonetarios.Brl(i.PrecoCentavos)</td><td data-label="Disponíveis"><span class="stock @(i.QuantidadeDisponivel == 0 ? "stock-empty" : null)">@i.QuantidadeDisponivel disponíveis</span></td><td data-label="Ações"><a href="/ingressos/@i.Id/">Consultar</a> · <a href="/ingressos/@i.Id/editar/">Editar</a></td></tr>}</tbody></table></div><partial name="_Paginacao" model="Model.Paginacao" />}
</section>
